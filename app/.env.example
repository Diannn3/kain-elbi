# Browser-safe Supabase values only. Never put a secret/service-role key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Required for owner-managed staff invitations/access.
# Never prefix this with PUBLIC_ and never expose it to browser code.
SUPABASE_SECRET_KEY=

# Optional analytics. Leave blank to keep Google Analytics completely disabled.
PUBLIC_GA_MEASUREMENT_ID=

# Confirm these before broad public beta.
PUBLIC_PRIVACY_CONTROLLER_NAME=UPPETITE Project
PUBLIC_PRIVACY_CONTACT_EMAIL=
