{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "astro build",
    "postbuild": "node scripts/generate-service-worker.mjs && node scripts/sync-vercel-output.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs --project=mobile-chromium --project=desktop-chromium --project=mobile-webkit",
    "test:perf": "node scripts/run-e2e.mjs --project=performance-chromium tests/e2e/performance.spec.ts",
    "test:visual": "node scripts/run-e2e.mjs --project=visual-chromium tests/e2e/visual.spec.ts",
    "test:visual:update": "node scripts/run-e2e.mjs --project=visual-chromium tests/e2e/visual.spec.ts --update-snapshots",
    "audit:build-size": "node scripts/report-build-size.mjs",
    "audit:editorial-privacy": "node scripts/audit-editorial-privacy.mjs",
    "audit:private-data": "node scripts/audit-private-data.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "astro": "^7.2.0",
    "maplibre-gl": "^6.2.0",
    "opening_hours": "^3.14.0",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "@astrojs/vercel": "^11.0.4",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
