---
import '@fontsource-variable/sora/wght.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import BottomNav from '../components/layout/BottomNav.astro';
import OfflineStatus from '../components/layout/OfflineStatus.svelte';
import SiteFooter from '../components/layout/SiteFooter.astro';
import {
	PWA_CLIENT_BOOTSTRAP_VERSION,
	PWA_MIN_UPDATE_GAP_MS,
	PWA_UPDATE_INTERVAL_MS,
} from '../lib/pwa-update.mjs';

interface Props {
	title?: string;
	description?: string;
	hideHeader?: boolean;
	hideNav?: boolean;
	pageClass?: string;
}

const {
	title = 'UPPETITE — Food That Fits Your Break',
	description = 'Route-aware food discovery for UPLB students, built with open data and privacy in mind.',
	hideHeader = false,
	hideNav = false,
	pageClass = '',
} = Astro.props;
const serviceWorkerEnabled = import.meta.env.PROD;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#5C1016" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:site_name" content="UPPETITE" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="en_PH" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<title>{title}</title>
		{gaMeasurementId && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
				<script is:inline define:vars={{ gaMeasurementId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', gaMeasurementId);
				</script>
			</>
		)}
		<slot name="head" />
	</head>
	<body class={pageClass}>
		<a class="skip-link" href="#main-content">Skip to Main Content</a>
		{!hideHeader && <SiteHeader currentPath={Astro.url.pathname} />}
		<OfflineStatus client:idle />
		<slot />
		{!hideNav && <BottomNav currentPath={Astro.url.pathname} />}
		<SiteFooter />
		<script
			define:vars={{
				serviceWorkerEnabled,
				pwaClientBootstrapVersion: PWA_CLIENT_BOOTSTRAP_VERSION,
				pwaUpdateIntervalMs: PWA_UPDATE_INTERVAL_MS,
				pwaMinUpdateGapMs: PWA_MIN_UPDATE_GAP_MS,
			}}
		>
			if (serviceWorkerEnabled && 'serviceWorker' in navigator) {
				const CLIENT_BOOTSTRAP_VERSION = pwaClientBootstrapVersion;
				const UPDATE_INTERVAL_MS = pwaUpdateIntervalMs;
				const MIN_UPDATE_GAP_MS = pwaMinUpdateGapMs;

				let registration = null;
				let refreshing = false;
				let hasHadController = Boolean(navigator.serviceWorker.controller);
				let lastUpdateCheck = 0;

				function reloadOnce() {
					if (refreshing) return;
					refreshing = true;
					window.location.reload();
				}

				/*
				 * The new worker probes open tabs before claiming them.
				 * Legacy cached HTML cannot answer this message, allowing
				 * the worker to identify and migrate it itself.
				 */
				navigator.serviceWorker.addEventListener('message', (event) => {
					if (event.data?.type === 'UPPETITE_CLIENT_VERSION_PROBE') {
						event.ports?.[0]?.postMessage({
							type: 'UPPETITE_CLIENT_VERSION',
							version: CLIENT_BOOTSTRAP_VERSION,
						});
						return;
					}

					if (event.data?.type === 'UPPETITE_FORCE_RELOAD') {
						reloadOnce();
					}
				});

				/*
				 * Avoid an unnecessary extra reload on the very first SW
				 * install. Once a page has had a controller, subsequent
				 * controller changes represent an update and must reload
				 * the document so HTML/CSS/JS/SW come from one deployment.
				 */
				navigator.serviceWorker.addEventListener('controllerchange', () => {
					if (!hasHadController) {
						hasHadController = true;
						return;
					}
					reloadOnce();
				});

				async function checkForUpdate(force = false) {
					if (!registration) return;

					const now = Date.now();
					if (!force && now - lastUpdateCheck < MIN_UPDATE_GAP_MS) return;
					lastUpdateCheck = now;

					try {
						await registration.update();
					} catch (error) {
						console.warn('UPPETITE service-worker update check failed.', error);
					}
				}

				async function registerServiceWorker() {
					try {
						registration = await navigator.serviceWorker.register('/sw.js', {
							scope: '/',
							updateViaCache: 'none',
						});

						/*
						 * Rescue an older worker that was already installed
						 * and waiting before this page loaded.
						 */
						if (registration.waiting) {
							registration.waiting.postMessage({ type: 'SKIP_WAITING' });
						}

						registration.addEventListener('updatefound', () => {
							const worker = registration.installing;
							if (!worker) return;

							worker.addEventListener('statechange', () => {
								if (
									worker.state === 'installed'
									&& navigator.serviceWorker.controller
								) {
									worker.postMessage({ type: 'SKIP_WAITING' });
								}
							});
						});

						/*
						 * Do not rely only on browser lifecycle heuristics.
						 * Check now, periodically, and whenever a student
						 * returns to a long-lived UPPETITE tab.
						 */
						await checkForUpdate(true);
						window.setInterval(() => void checkForUpdate(), UPDATE_INTERVAL_MS);
					} catch (error) {
						console.error('UPPETITE service-worker registration failed.', error);
					}
				}

				window.addEventListener('load', () => {
					void registerServiceWorker();
				});

				document.addEventListener('visibilitychange', () => {
					if (document.visibilityState === 'visible') {
						void checkForUpdate();
					}
				});

				window.addEventListener('focus', () => void checkForUpdate());
				window.addEventListener('online', () => void checkForUpdate(true));
				window.addEventListener('pageshow', (event) => {
					if (event.persisted) void checkForUpdate(true);
				});
			}
		</script>
	</body>
</html>
