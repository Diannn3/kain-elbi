---
import Layout from '../layouts/Layout.astro';
import RoutePlanner from '../components/forms/RoutePlanner.svelte';
import HeroAtmosphere from '../components/home/HeroAtmosphere.astro';
import { loadBuildData } from '../lib/data/build';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '../styles/hero-polish.css';

const { matrix, places, zones, freshie } = await loadBuildData();
const anchors = Object.values(matrix.anchors);
const namedZones = zones.filter((zone) => zone.id !== 'elsewhere-lb');
---

<Layout pageClass="home-page">
	<main id="main-content">
		<section class="hero" aria-labelledby="home-heading">
			<HeroAtmosphere />

			<div class="hero-inner page-shell">
				<div class="hero-copy">
					<p class="kicker">Find · Between Classes</p>
					<h1 id="home-heading">
						<span class="headline-line">Food That Fits</span>
						<span class="headline-line headline-line--editorial">Your Break<span class="headline-stop" aria-hidden="true">.</span></span>
					</h1>
					<p class="lede">Choose where you are, where class is next, and how long you have. We’ll show only food stops that fit the walk.</p>
				</div>

				<div class="hero-planner"><RoutePlanner {anchors} client:load /></div>
			</div>
		</section>

		<section class="modes page-shell" aria-labelledby="modes-heading">
			<div class="section-heading">
				<div>
					<p class="eyebrow-global">More Ways to Use UPPETITE</p>
					<h2 id="modes-heading">Not between classes?</h2>
				</div>
			</div>

			<div class="mode-grid">
				<a class="mode-card explore" href="/explore">
					<span>Explore</span>
					<strong>See what’s around Elbi.</strong>
					<p>Search the full {places.length}-place open-data catalog by area or food type, with List and Map views.</p>
					<b>{namedZones.length} named food zones →</b>
				</a>

				<a class="mode-card freshie" href="/freshie">
					<span>Freshie</span>
					<strong>Learn how Elbi eats.</strong>
					<p>A beginner-friendly guide to food zones and a non-ranked starter pack backed by recent public discussions.</p>
					<b>{freshie.mentions.length} evidence records →</b>
				</a>
			</div>
		</section>

		<section class="principle page-shell" aria-labelledby="principle-heading">
			<div>
				<p class="eyebrow-global">What UPPETITE Is For</p>
				<h2 id="principle-heading">Three questions. Three modes.</h2>
			</div>

			<div class="principle-grid">
				<article>
					<span>Find</span>
					<strong>Can I eat there and still make class?</strong>
					<p>Uses verified campus walking routes and your exact time budget.</p>
				</article>
				<article>
					<span>Explore</span>
					<strong>What food exists around Elbi?</strong>
					<p>Discover every food spot in Elbi, including those off the beaten path, across the complete open-data catalog.</p>
				</article>
				<article>
					<span>Freshie</span>
					<strong>Where do I even start?</strong>
					<p>Learn the local food areas and see which places the community is talking about, kept completely unranked.</p>
				</article>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		position: relative;
		min-height: 45rem;
		min-height: 100svh;
		overflow: clip;
		isolation: isolate;
		color: var(--brand-cream);
		background:
			linear-gradient(132deg, #4b0c12 0%, var(--brand-maroon-deep) 26%, #741018 57%, var(--brand-maroon) 100%);
	}

	.hero::before {
		content: '';
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(90deg, rgb(26 2 5 / 0.15), transparent 34%, transparent 72%, rgb(39 2 6 / 0.08)),
			linear-gradient(to bottom, rgb(28 2 5 / 0.06), transparent 25%, transparent 75%, rgb(28 2 5 / 0.12));
	}

	.hero-inner {
		position: relative;
		z-index: 4;
		min-height: inherit;
		display: grid;
		align-content: center;
		align-items: center;
		gap: var(--space-10);
		width: var(--page-wide);
		padding-top: 7.1rem;
		padding-bottom: 2.6rem;
	}

	.hero-copy {
		position: relative;
		z-index: 5;
		min-width: 0;
		max-width: 46rem;
	}

	.kicker {
		display: flex;
		align-items: center;
		gap: 0.82rem;
		margin: 0 0 1.75rem;
		color: var(--brand-cream);
		font: 760 0.76rem / 1 var(--font-display);
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.kicker::before {
		content: '';
		width: 2.45rem;
		height: 0.2rem;
		flex: none;
		border-radius: 999px;
		background: var(--brand-orange);
		box-shadow: 0 0 1.1rem rgb(230 106 25 / 0.18);
	}

	h1 {
		margin: 0;
		color: var(--brand-cream);
		font: 820 clamp(3.45rem, 4.7vw, 5rem) / 0.94 var(--font-display);
		letter-spacing: -0.065em;
		text-shadow: 0 0.2rem 1.7rem rgb(35 4 8 / 0.08);
	}

	.headline-line {
		display: block;
		white-space: nowrap;
	}

	.headline-line--editorial {
		margin-top: 0.16em;
		font-family: var(--font-editorial);
		font-size: 1.13em;
		font-style: italic;
		font-weight: 500;
		line-height: 0.84;
		letter-spacing: -0.045em;
	}

	.headline-stop {
		color: var(--brand-orange);
		font-style: normal;
	}

	.lede {
		max-width: 32rem;
		margin: 2.4rem 0 0;
		color: var(--brand-sand);
		font-size: clamp(1rem, 1.45vw, 1.13rem);
		line-height: 1.62;
		text-wrap: pretty;
	}

	.hero-planner {
		position: relative;
		z-index: 6;
		width: 100%;
		max-width: 47rem;
		min-width: 0;
		justify-self: end;
		animation: planner-enter 520ms 120ms both cubic-bezier(0.22, 1, 0.36, 1);
	}

	@keyframes planner-enter {
		from { opacity: 0; transform: translateY(0.45rem); }
		to { opacity: 1; transform: translateY(0); }
	}

	.modes,
	.principle {
		margin-top: clamp(4rem, 10vw, 7rem);
	}

	.mode-grid {
		display: grid;
		gap: 1rem;
	}

	.mode-card {
		position: relative;
		min-height: 17rem;
		display: flex;
		flex-direction: column;
		padding: clamp(1.4rem, 4vw, 2rem);
		border-radius: 1.7rem;
		text-decoration: none;
		overflow: hidden;
		transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
	}

	.mode-card:hover {
		transform: translateY(-2px);
	}

	.mode-card > span {
		font: 760 0.72rem / 1 var(--font-display);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.mode-card strong {
		max-width: 12ch;
		margin: 0.8rem 0 0;
		font: 790 clamp(2rem, 7vw, 3.2rem) / 0.92 var(--font-display);
		letter-spacing: -0.04em;
	}

	.mode-card p {
		max-width: 35rem;
		margin: 0.9rem 0 0;
		line-height: 1.48;
	}

	.mode-card b {
		margin-top: auto;
		padding-top: 1.3rem;
		font-size: 0.9rem;
	}

	.mode-card.explore {
		background: var(--brand-maroon-deep);
		color: var(--brand-cream);
		box-shadow: 0 1rem 2.5rem rgb(92 16 22 / 0.14);
	}

	.mode-card.explore > span,
	.mode-card.explore b {
		color: var(--color-accent-on-dark);
	}

	.mode-card.explore p {
		color: var(--brand-sand);
	}

	.mode-card.freshie {
		border: 1px solid var(--color-border);
		background: var(--brand-sand);
		color: var(--brand-charcoal);
	}

	.mode-card.freshie > span,
	.mode-card.freshie b,
	.mode-card.freshie strong {
		color: var(--brand-maroon-deep);
	}

	.mode-card.freshie::after {
		content: '';
		position: absolute;
		right: -3rem;
		bottom: -3rem;
		width: 9rem;
		aspect-ratio: 1;
		border: 1.4rem solid rgb(102 101 31 / 0.1);
		border-radius: 50%;
		pointer-events: none;
	}

	.principle {
		padding: clamp(1.5rem, 5vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: 2rem;
		background: var(--color-surface-raised);
		box-shadow: 0 1rem 3rem rgb(92 16 22 / 0.05);
	}

	.principle h2 {
		max-width: 14ch;
		margin: 0.5rem 0 0;
		color: var(--color-primary);
		font: 780 clamp(2rem, 6vw, 4rem) / 0.96 var(--font-display);
		letter-spacing: -0.045em;
	}

	.principle-grid {
		display: grid;
		gap: 1rem;
		margin-top: 2rem;
	}

	.principle-grid article {
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}

	.principle-grid span {
		color: var(--color-text-accent);
		font: 760 0.72rem / 1 var(--font-display);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.principle-grid strong {
		display: block;
		margin: 0.5rem 0 0;
		color: var(--color-primary);
		font: 730 1.15rem / 1.1 var(--font-display);
	}

	.principle-grid p {
		margin: 0.5rem 0 0;
		color: var(--color-text-muted);
		line-height: 1.45;
	}

	@media (min-width: 1100px) {
		.hero-inner {
			grid-template-columns: minmax(0, 0.48fr) minmax(36rem, 0.52fr);
			gap: clamp(4rem, 4.2vw, 5rem);
		}

		.mode-grid {
			grid-template-columns: 1fr 1fr;
		}

		.principle-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 1099px) {
		.hero {
			min-height: auto;
		}

		.hero-inner {
			width: var(--page);
			padding-top: 7.5rem;
			padding-bottom: 3.5rem;
		}

		.hero-copy {
			max-width: 42rem;
		}

		.hero-planner {
			width: min(100%, 46rem);
			justify-self: start;
		}
	}

	@media (min-width: 1100px) and (max-height: 820px) {
		.hero-inner {
			padding-top: 5.8rem;
			padding-bottom: 1.5rem;
			gap: 3.2rem;
		}

		h1 {
			font-size: clamp(3.25rem, 4.35vw, 4.45rem);
		}

		.lede {
			margin-top: 1.9rem;
		}
	}

	@media (max-width: 620px) {
		.hero-inner {
			gap: var(--space-8);
			padding-top: 6.7rem;
			padding-bottom: var(--space-8);
		}

		h1 {
			font-size: clamp(2.45rem, 11.5vw, 3.5rem);
		}

		.headline-line {
			white-space: normal;
		}

		.headline-line--editorial {
			font-size: 1.08em;
			line-height: 0.9;
		}

		.lede {
			margin-top: 1.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mode-card,
		.hero-planner {
			animation: none;
		}

		.mode-card {
			transition: none;
		}
	}
</style>
