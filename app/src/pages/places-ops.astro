---
import { readFile } from 'node:fs/promises';
import Layout from '../layouts/Layout.astro';
import PlacesOpsDashboard from '../components/ops/PlacesOpsDashboard.svelte';
import { loadBuildData } from '../lib/data/build';
import { buildOpsDashboard } from '../lib/ops-dashboard';
import { validatePlaceAudit, type PlaceAuditEvent } from '../lib/place-audit';
import { validatePlaceFeedback, type PlaceFeedbackSummary } from '../lib/place-feedback';

const { places } = await loadBuildData();
const placeNameById = new Map(places.map((place) => [place.id, place.name]));

let auditEvents: PlaceAuditEvent[] = [];
let feedbackRows: PlaceFeedbackSummary[] = [];

try {
  const raw = JSON.parse(await readFile(new URL('../../../data/place_audit.json', import.meta.url), 'utf8'));
  auditEvents = validatePlaceAudit(raw).events.map((event) => ({
    ...event,
    placeName: event.placeName ?? placeNameById.get(event.placeId),
  }));
} catch {
  auditEvents = [];
}

try {
  const raw = JSON.parse(await readFile(new URL('../../../data/place_feedback.json', import.meta.url), 'utf8'));
  feedbackRows = validatePlaceFeedback(raw).rows;
} catch {
  feedbackRows = [];
}

const dashboard = buildOpsDashboard(places, new Date(), feedbackRows);
---

<Layout title="Places Ops — UPPETITE" description="Privacy-safe data health and verification queue for the UPPETITE Places team.">
  <Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
  <main id="main-content">
    <PlacesOpsDashboard {dashboard} {auditEvents} client:load />
    <p class="access-note page-shell"><strong>Operational note:</strong> <code>noindex</code> keeps this page out of normal search indexing, but it is not authentication. Add hosting-level access control before putting team-only information here.</p>
  </main>
</Layout>

<style>
  .access-note { margin-top: -4rem; padding-bottom: 5rem; color: var(--color-text-muted); font-size: .78rem; line-height: 1.55; }
  .access-note strong, .access-note code { color: var(--brand-maroon-deep); }
</style>
