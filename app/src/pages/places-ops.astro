---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PlacesOpsDashboard from '../components/ops/PlacesOpsDashboard.svelte';
import { loadBuildData } from '../lib/data/build';
import { buildOpsDashboard } from '../lib/ops-dashboard';
import { getStaffContext } from '../lib/auth/guards';
import { setPrivateNoStore } from '../lib/auth/server';
import { loadLiveOpsData } from '../lib/ops-server';

setPrivateNoStore(Astro.response.headers);
const { supabase, identity } = await getStaffContext(Astro.request, Astro.cookies);
if (!identity) return Astro.redirect('/staff/login?next=/places-ops', 302);
const { places } = await loadBuildData();
const placeNameById = new Map(places.map((place) => [place.id, place.name]));
let loadError = '';
let live = { feedbackRows: [], feedbackSummary: [], auditEvents: [] } as Awaited<ReturnType<typeof loadLiveOpsData>>;
try { live = await loadLiveOpsData(supabase, placeNameById); }
catch { loadError = 'Live operational data is temporarily unavailable.'; }
const dashboard = buildOpsDashboard(places, new Date(), live.feedbackSummary);
const placeNames = Object.fromEntries(placeNameById);
---
<Layout title="Places Ops — UPPETITE" description="Private data health and verification queue for the UPPETITE Places team." hideNav>
  <Fragment slot="head"><meta name="robots" content="noindex,nofollow,noarchive" /></Fragment>
  <main id="main-content">
    {loadError && <p class="ops-error page-shell" role="alert">{loadError}</p>}
    <PlacesOpsDashboard {dashboard} auditEvents={live.auditEvents} feedbackRows={live.feedbackRows} role={identity.role} {placeNames} client:load />
  </main>
</Layout>
<style>.ops-error{margin-top:var(--space-4);padding:var(--space-3);border-radius:var(--radius-sm);background:rgb(92 16 22/.08);color:var(--brand-maroon-deep);font-weight:680}</style>
