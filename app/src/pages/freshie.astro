---
import Layout from '../layouts/Layout.astro';
import { loadBuildData } from '../lib/data/build';

const { places, zones, collections, freshie } = await loadBuildData();
const placeById = new Map(places.map((place) => [place.id, place]));
const zoneByPlace = new Map<string, (typeof zones)[number]>();
for (const zone of zones) for (const id of zone.placeIds) zoneByPlace.set(id, zone);
const starter = collections.find((item) => item.id === freshie.starterCollectionId);
const starterPlaces = (starter?.placeIds ?? []).map((id) => placeById.get(id)).filter(Boolean);
const mentionsByPlace = new Map<string, typeof freshie.mentions>();
for (const mention of freshie.mentions) mentionsByPlace.set(mention.placeId, [...(mentionsByPlace.get(mention.placeId) ?? []), mention]);
const starterItems = starterPlaces.filter((place): place is NonNullable<typeof place> => Boolean(place)).map((place) => ({
	place,
	zone: zoneByPlace.get(place.id),
	mentions: mentionsByPlace.get(place.id) ?? [],
}));
const sourceEntries = Object.entries(freshie.sources).filter(([, source]) => source.url);
const formatter = new Intl.DateTimeFormat('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout title="Freshie Mode — UPPETITE" description="A beginner-friendly guide to Elbi food zones and recent public student/community food mentions.">
	<main id="main-content" class="page-shell freshie-page">
		<section class="freshie-hero">
			<div class="freshie-copy">
				<p class="freshie-badge"><span aria-hidden="true"></span>Freshie Mode 🌱</p>
				<h1>Learn how Elbi eats<span aria-hidden="true">.</span></h1>
				<p>{freshie.intro}</p>
			</div>
			<div class="research-card">
				<strong>Research snapshot</strong>
				<span>{formatter.format(new Date(freshie.researchDate))}</span>
				<p>{freshie.sourceNote}</p>
			</div>
		</section>

		<section class="start" aria-labelledby="start-heading">
			<div class="section-heading"><div><p class="eyebrow-global">Start Here</p><h2 id="start-heading">Pick the situation you’re in.</h2></div></div>
			<div class="situation-grid">
				{freshie.situations.map((situation, index) => (
					<a href={`/explore${situation.explore_query ? `?${situation.explore_query}` : ''}`}>
						<span>{String(index + 1).padStart(2, '0')}</span><strong>{situation.title}</strong><p>{situation.description}</p><b>Explore →</b>
					</a>
				))}
			</div>
		</section>

		<section class="zones" aria-labelledby="freshie-zones-heading">
			<div class="section-heading"><div><p class="eyebrow-global">Know Your Food Zones</p><h2 id="freshie-zones-heading">The map makes more sense once you know the names.</h2></div></div>
			<div class="zone-rail">
				{zones.filter((zone) => zone.id !== 'elsewhere-lb').map((zone) => (
					<a href={`/explore?zone=${zone.id}`}><span>{zone.placeCount} catalog places</span><strong>{zone.name}</strong><p>{zone.description}</p></a>
				))}
			</div>
			<p class="fineprint">Zone names and boundaries are UPPETITE discovery labels. They are not official administrative boundaries.</p>
		</section>

		{starter && starterPlaces.length > 0 && (
			<section class="starter" aria-labelledby="starter-heading">
				<div class="section-heading"><div><p class="eyebrow-global">Freshie Starter Pack</p><h2 id="starter-heading">Places that keep showing up in recent public discussions.</h2></div></div>
				<p class="starter-note">Non-ranked. Inclusion means we found recent public student/community evidence for the place and matched it to Kain’s open-data catalog; it does not mean “best restaurant.”</p>
				<div class="starter-grid">
					{starterItems.map(({ place, zone, mentions }) => (
						<article>
							<p class="place-meta">{zone?.shortName ?? 'Los Baños'} · {place.category.replace('_',' ')}</p>
							<h3><a href={`/place/${place.id}`}>{place.name}</a></h3>
							{mentions[0] && <p class="why">{mentions[0].summary}</p>}
							<small>{mentions.length} public evidence record{mentions.length === 1 ? '' : 's'}</small>
						</article>
					))}
				</div>
			</section>
		)}

		<section class="glossary" aria-labelledby="glossary-heading">
			<div class="section-heading"><div><p class="eyebrow-global">Elbi Food Glossary</p><h2 id="glossary-heading">Terms Kain uses.</h2></div></div>
			<dl>{freshie.glossary.map((item) => <div><dt>{item.term}</dt><dd>{item.definition}</dd></div>)}</dl>
		</section>

		<section class="sources" aria-labelledby="sources-heading">
			<details>
				<summary id="sources-heading">Sources reviewed for Freshie Mode</summary>
				<p>These links support the editorial layer only. Kain’s place coordinates/categories still come from the open-data catalog.</p>
				<ul>{sourceEntries.map(([, source]) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.name}</a>{source.publishedAt && <span> · {source.publishedAt}</span>}</li>)}</ul>
			</details>
		</section>
	</main>
</Layout>

<style>
	.freshie-page { padding-top: clamp(2rem, 6vw, 4.5rem); padding-bottom: 1rem; }
	.freshie-hero { display: grid; gap: 1.25rem; padding: clamp(1.35rem, 4vw, 2.5rem); border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--brand-cream); box-shadow: 0 0.8rem 2rem rgb(71 12 17 / 0.05); }
	.freshie-badge { width: fit-content; display: inline-flex; align-items: center; gap: 0.55rem; margin: 0; padding: 0.5rem 0.72rem; border: 1px solid rgb(102 101 31 / 0.32); border-radius: 999px; background: rgb(102 101 31 / 0.12); color: #4f4e18; font: 760 0.72rem/1 var(--font-display); letter-spacing: 0.07em; text-transform: uppercase; }
	.freshie-badge > span { width: 0.62rem; height: 0.62rem; border: 2px solid var(--brand-olive); border-radius: 50%; background: var(--brand-cream); box-shadow: 0 0 0 3px rgb(102 101 31 / 0.12); }
	.freshie-copy h1 { max-width: 11ch; margin: 0.75rem 0 0; color: var(--brand-maroon-deep); font: 820 clamp(3rem, 11vw, 6.3rem)/0.87 var(--font-display); letter-spacing: -0.06em; }
	.freshie-copy h1 span { color: var(--brand-orange); }
	.freshie-copy > p:last-child { max-width: 43rem; margin: 1.25rem 0 0; color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.55; }
	.research-card { position: relative; align-self: end; padding: 1.15rem 1.15rem 1.15rem 1.35rem; border: 1px solid rgb(102 101 31 / 0.28); border-radius: 1.3rem; background: var(--brand-sand); overflow: hidden; }
	.research-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 0.32rem; background: var(--brand-olive); }
	.research-card strong,
	.research-card span { display: block; color: #4f4e18; }
	.research-card strong { font: 760 0.74rem/1 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; }
	.research-card span { margin: 0.45rem 0 0; font-weight: 780; }
	.research-card p { margin: 0.65rem 0 0; color: var(--color-text-muted); font-size: 0.85rem; line-height: 1.45; }
	.start,
	.zones,
	.starter,
	.glossary,
	.sources { margin-top: clamp(3.5rem, 9vw, 6rem); }
	.situation-grid { display: grid; gap: 0.75rem; }
	.situation-grid a { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 0.8rem; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 1.2rem; background: var(--brand-cream); text-decoration: none; overflow: hidden; }
	.situation-grid a:nth-child(even) { background: var(--brand-sand); }
	.situation-grid a::after { content: ''; position: absolute; right: 1rem; bottom: 1rem; width: 3rem; border-top: 2px dashed var(--brand-orange); opacity: 0.8; }
	.situation-grid span { grid-row: 1 / 4; color: var(--brand-orange); font: 800 0.8rem/1 var(--font-display); }
	.situation-grid strong { color: var(--brand-maroon-deep); font: 760 1.15rem/1.05 var(--font-display); }
	.situation-grid p { margin: 0; color: var(--color-text-muted); font-size: 0.86rem; line-height: 1.4; }
	.situation-grid b { color: var(--brand-maroon-deep); font-size: 0.82rem; }
	.zone-rail { display: grid; grid-auto-flow: column; grid-auto-columns: min(80vw, 20rem); gap: 0.75rem; overflow-x: auto; padding: 0.15rem 0 1rem; scroll-snap-type: x mandatory; }
	.zone-rail a { position: relative; min-height: 11rem; padding: 1.1rem; border: 1px solid rgb(102 101 31 / 0.28); border-radius: 1.25rem; background: var(--brand-sand); color: var(--color-text); text-decoration: none; scroll-snap-align: start; overflow: hidden; }
	.zone-rail a::before { content: ''; position: absolute; top: 1rem; right: 1rem; width: 0.72rem; height: 0.72rem; border: 3px solid var(--brand-olive); border-radius: 50%; background: var(--brand-cream); }
	.zone-rail a::after { content: ''; position: absolute; top: 1.86rem; right: 1.62rem; width: 3.6rem; border-top: 2px dashed var(--brand-orange); transform: rotate(-18deg); transform-origin: right center; }
	.zone-rail span { color: #4f4e18; font: 720 0.68rem/1 var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; }
	.zone-rail strong { display: block; max-width: 13ch; margin: 1.35rem 0 0; color: var(--brand-maroon-deep); font: 760 1.45rem/1 var(--font-display); }
	.zone-rail p { margin: 0.6rem 0 0; color: var(--color-text-muted); line-height: 1.4; }
	.fineprint,
	.starter-note { max-width: 48rem; color: var(--color-text-muted); font-size: 0.82rem; line-height: 1.45; }
	.starter-grid { display: grid; gap: 0.75rem; }
	.starter-grid article { padding: 1.1rem; border: 1px solid var(--color-border); border-radius: 1.2rem; background: var(--brand-cream); }
	.starter-grid article:nth-child(even) { background: var(--brand-sand); }
	.place-meta { margin: 0; color: #4f4e18; font: 740 0.68rem/1 var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; }
	.starter-grid h3 { margin: 0.55rem 0 0; color: var(--brand-maroon-deep); font: 760 1.35rem/1 var(--font-display); }
	.starter-grid h3 a { text-decoration: none; }
	.why { margin: 0.55rem 0 0; color: var(--color-text-muted); line-height: 1.45; }
	.starter-grid small { display: block; margin: 0.7rem 0 0; color: var(--color-text-muted); }
	.glossary dl { display: grid; gap: 0.6rem; margin: 0; }
	.glossary dl div { padding: 1rem; border: 1px solid var(--color-border); border-radius: 1rem; background: var(--brand-cream); }
	.glossary dl div:nth-child(even) { background: var(--brand-sand); }
	.glossary dt { color: var(--brand-maroon-deep); font: 760 1rem/1 var(--font-display); }
	.glossary dd { margin: 0.45rem 0 0; color: var(--color-text-muted); line-height: 1.5; }
	.sources details { padding: 1rem; border: 1px solid rgb(102 101 31 / 0.28); border-radius: 1.2rem; background: var(--brand-sand); }
	.sources summary { min-height: var(--tap-target); display: flex; align-items: center; color: #4f4e18; font-weight: 760; cursor: pointer; }
	.sources p,
	.sources li { color: var(--color-text-muted); line-height: 1.5; }
	.sources a { color: var(--brand-maroon-deep); font-weight: 700; }
	@media (min-width: 800px) {
		.freshie-hero { grid-template-columns: 1fr 20rem; align-items: end; }
		.situation-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.starter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.zone-rail { grid-auto-columns: min(30vw, 20rem); }
	}
</style>
