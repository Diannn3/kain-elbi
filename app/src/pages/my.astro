---
import Layout from '../layouts/Layout.astro';
import PersonalHub from '../components/personal/PersonalHub.svelte';
import { loadBuildData } from '../lib/data/build';
const { matrix } = await loadBuildData();
const anchors = Object.values(matrix.anchors);
---
<Layout title="My UPPETITE — UPPETITE" description="Your private UPPETITE timetable, quick routes, recommendation lists, and food journal.">
  <main id="main-content"><PersonalHub {anchors} client:load /></main>
</Layout>
