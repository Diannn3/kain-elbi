---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Offline — UPetite Elbi"><main id="main-content" class="offline page-shell"><div aria-hidden="true">A · · · Food · · · B</div><p>Offline</p><h1>Your saved route data is still on this device.</h1><span>Return to a page you opened before, or reconnect to load a new page. UPetite Elbi never caches exact GPS coordinates.</span><a href="/">Try the Route Planner</a></main></Layout>
<style>
	.offline { display: grid; align-content: center; min-height: 70dvh; padding-block: 3rem; }
	.offline div { width: fit-content; padding: .8rem 1rem; border-radius: 999px; color: var(--forest); background: var(--sun); font-weight: 800; }
	.offline p { margin: 1.5rem 0 .4rem; color: var(--text-accent); font-weight: 750; text-transform: uppercase; }
	.offline h1 { max-width: 14ch; margin: 0 0 1rem; color: var(--forest); font: 790 clamp(2.5rem, 10vw, 5rem)/.92 var(--font-display); }
	.offline span { max-width: 38rem; color: var(--muted); line-height: 1.5; }
	.offline a { width: fit-content; margin-top: 1.5rem; padding: 1rem; border-radius: .9rem; color: white; background: var(--forest); font-weight: 750; }
</style>
