---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { createAdminSupabaseClient } from '../../lib/auth/admin';
import { getStaffContext } from '../../lib/auth/guards';
import { setPrivateNoStore } from '../../lib/auth/server';

setPrivateNoStore(Astro.response.headers);
const { supabase, identity } = await getStaffContext(Astro.request, Astro.cookies);
if (!identity) return Astro.redirect('/staff/login?next=/places-ops/access', 302);
if (identity.role !== 'owner') return new Response('Forbidden', { status: 403, headers: Astro.response.headers });
const admin = createAdminSupabaseClient();
const [{ data: memberships = [], error: membershipError }, usersResult] = await Promise.all([
  supabase.from('uppetite_staff_members').select('user_id,role,active,created_at,updated_at').order('created_at', { ascending:true }),
  admin.auth.admin.listUsers({ page:1, perPage:100 }),
]);
if (membershipError) return new Response('Unable to load team access.', { status:500, headers:Astro.response.headers });
const emailById = new Map((usersResult.data?.users ?? []).map((user) => [user.id, user.email ?? 'No email']));
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---
<Layout title="Team Access — UPPETITE" description="Owner-only UPPETITE team access management." hideNav>
  <main id="main-content" class="access-shell page-shell">
    <header><p class="eyebrow-global">Owner tools</p><h1>Team access.</h1><p>Invite only people who should see Places Ops. Editor's Picks remain owner-only regardless of Places role.</p></header>
    {ok && <p class="status" role="status">Access updated.</p>}{error && <p class="status error" role="alert">The invite could not be completed. Check the email, redirect allowlist, SMTP, and Supabase logs.</p>}
    <section class="panel"><div class="heading"><h2>Current team</h2><a href="/places-ops">Back to Places Ops</a></div><div class="members">
      {memberships.map((member) => <article><div><strong>{emailById.get(member.user_id) ?? member.user_id}</strong><span>{member.role.replace('_',' ')} · {member.active ? 'Active' : 'Revoked'}</span></div>{member.role !== 'owner' && <div class="member-actions"><form method="post" action={`/api/ops/access/${member.user_id}`}><input type="hidden" name="action" value="role"/><select name="role" aria-label={`Role for ${emailById.get(member.user_id) ?? 'member'}`}><option value="places_viewer" selected={member.role === 'places_viewer'}>Places Viewer</option><option value="places_editor" selected={member.role === 'places_editor'}>Places Editor</option></select><button type="submit">Save role</button></form><form method="post" action={`/api/ops/access/${member.user_id}`}><input type="hidden" name="action" value="revoke"/><button class="quiet" type="submit" disabled={!member.active}>Revoke</button></form></div>}</article>)}
    </div></section>
    <section class="panel invite"><h2>Invite member</h2><form method="post" action="/api/ops/access/invite"><label>Email<input name="email" type="email" required autocomplete="off"/></label><label>Role<select name="role"><option value="places_viewer">Places Viewer</option><option value="places_editor">Places Editor</option></select></label><button type="submit">Send invite</button></form><p>Owner access cannot be assigned here. The single owner is bootstrapped deliberately in Supabase.</p></section>
  </main>
</Layout>
<style>.access-shell{padding-top:clamp(2rem,6vw,5rem);padding-bottom:6rem}header{max-width:56rem}h1{max-width:10ch;margin:var(--space-3) 0;color:var(--brand-maroon-deep);font:820 clamp(2.8rem,9vw,5rem)/.92 var(--font-display);letter-spacing:-.05em}header>p:last-child,.invite>p{color:var(--color-text-muted);line-height:1.55}.status{margin-top:var(--space-4);padding:var(--space-3);border-radius:var(--radius-sm);background:rgb(102 101 31/.1);color:#4f4e18}.status.error{background:rgb(92 16 22/.08);color:var(--brand-maroon-deep)}.panel{margin-top:var(--space-6);padding:var(--space-5);border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--brand-cream)}.heading{display:flex;justify-content:space-between;gap:var(--space-3);align-items:center}h2{margin:0;color:var(--brand-maroon-deep);font:780 1.7rem/1 var(--font-display)}a{color:var(--brand-maroon-deep);font-weight:720}.members{display:grid;margin-top:var(--space-3)}article{display:grid;gap:var(--space-3);padding:var(--space-3) 0;border-top:1px solid var(--color-border)}article>div:first-child{display:grid;gap:.25rem}article span{color:var(--color-text-muted);font-size:.8rem}.member-actions,.member-actions form,.invite form{display:flex;flex-wrap:wrap;gap:var(--space-2)}select,input,button{min-height:var(--tap-target);border-radius:var(--radius-sm);font:inherit}select,input{padding:0 var(--space-3);border:1px solid var(--color-border);background:#fff}button{padding:0 var(--space-3);border:1px solid var(--brand-maroon-deep);background:var(--brand-maroon-deep);color:var(--brand-cream);font-weight:740;cursor:pointer}button.quiet{background:transparent;color:var(--brand-maroon-deep)}button:disabled{opacity:.45;cursor:not-allowed}.invite form{margin-top:var(--space-4)}label{display:grid;gap:.35rem;color:var(--color-text-muted);font-size:.75rem;font-weight:720}.invite label:first-child{flex:1;min-width:min(100%,18rem)}@media(min-width:800px){article{grid-template-columns:1fr auto;align-items:center}}
</style>
