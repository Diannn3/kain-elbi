---
import Layout from '../layouts/Layout.astro';

const contributions = [
	{
		id: 'add-place',
		label: 'Add a Place',
		title: 'Know somewhere we’re missing?',
		description: 'Suggest a food place that is not yet in the UPPETITE catalog.',
		href: 'https://forms.gle/REPLACE_WITH_ADD_PLACE_FORM',
		action: 'Open Add a Place form',
	},
	{
		id: 'suggest-edit',
		label: 'Suggest an Edit',
		title: 'Something changed?',
		description: 'Tell us about corrected hours, categories, contact details, or a moved/closed place.',
		href: 'https://forms.gle/REPLACE_WITH_SUGGEST_EDIT_FORM',
		action: 'Open Suggest an Edit form',
	},
	{
		id: 'add-photos',
		label: 'Add Photos',
		title: 'Help people recognize the place.',
		description: 'Temporary Google Form placeholder for photo submissions. Phase C will replace this with the native moderated photo pipeline.',
		href: 'https://forms.gle/REPLACE_WITH_ADD_PHOTOS_FORM',
		action: 'Open Add Photos form',
	},
	{
		id: 'report-problem',
		label: 'Report a Problem',
		title: 'Found something wrong?',
		description: 'Report broken information, a duplicate listing, an unsafe link, or another issue with the app or catalog.',
		href: 'https://forms.gle/REPLACE_WITH_REPORT_PROBLEM_FORM',
		action: 'Open Report a Problem form',
	},
];
---

<Layout title="Contribute — UPPETITE" description="Help improve UPPETITE by suggesting places, corrections, photos, or catalog issues.">
	<main id="main-content" class="contribute-page page-shell">
		<header class="contribute-hero">
			<div>
				<p class="eyebrow-global">Community Contributions</p>
				<h1>Help make UPPETITE more useful<span aria-hidden="true">.</span></h1>
				<p>Suggestions are reviewed before they affect the canonical place catalog or route coverage. Community submissions never directly change Smart Picks.</p>
			</div>
			<aside aria-label="Contribution review note">
				<strong>Reviewed, not automatic</strong>
				<p>Submit what you know. The UPPETITE team checks contributions before they become part of the public dataset.</p>
			</aside>
		</header>

		<section class="contribution-grid" aria-label="Contribution options">
			{contributions.map((item, index) => (
				<article id={item.id} class="contribution-card">
					<span>{String(index + 1).padStart(2, '0')} · {item.label}</span>
					<h2>{item.title}</h2>
					<p>{item.description}</p>
					<a href={item.href} target="_blank" rel="noreferrer">{item.action} <span aria-hidden="true">↗</span></a>
				</article>
			))}
		</section>

		<section class="privacy-note" aria-labelledby="contribute-privacy-title">
			<p class="eyebrow-global">Community Layer</p>
			<h2 id="contribute-privacy-title">The routing core stays separate.</h2>
			<p>Phase A uses forms for suggestions only. Popularity telemetry and native photo uploads remain isolated future community features; they do not change UPPETITE’s route-fit ranking.</p>
		</section>
	</main>
</Layout>

<style>
	.contribute-page { padding-top: clamp(2rem, 6vw, 4.5rem); padding-bottom: 2rem; }
	.contribute-hero { display: grid; gap: var(--space-4); padding: clamp(1.5rem, 5vw, 3rem); border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--brand-cream); box-shadow: 0 1rem 2.6rem rgb(71 12 17 / 0.06); }
	.contribute-hero h1 { max-width: 12ch; margin: var(--space-3) 0 0; color: var(--brand-maroon-deep); font: 820 clamp(2.8rem, 10vw, 5.6rem)/0.9 var(--font-display); letter-spacing: -0.055em; }
	.contribute-hero h1 span { color: var(--brand-orange); }
	.contribute-hero > div > p:last-child { max-width: 44rem; margin: var(--space-4) 0 0; color: var(--color-text-muted); line-height: 1.6; }
	.contribute-hero aside { align-self: end; padding: var(--space-5); border: 1px solid rgb(102 101 31 / 0.28); border-radius: var(--radius-lg); background: var(--brand-sand); }
	.contribute-hero aside strong { color: var(--brand-olive); font: 760 0.78rem/1 var(--font-display); letter-spacing: 0.07em; text-transform: uppercase; }
	.contribute-hero aside p { margin: var(--space-3) 0 0; color: var(--color-text-muted); line-height: 1.5; }
	.contribution-grid { display: grid; gap: var(--space-4); margin-top: var(--space-6); }
	.contribution-card { scroll-margin-top: 2rem; display: flex; flex-direction: column; min-height: 17rem; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--brand-cream); }
	.contribution-card:nth-child(even) { background: var(--brand-sand); }
	.contribution-card > span { color: var(--brand-maroon-deep); font: 760 0.7rem/1 var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; }
	.contribution-card h2 { max-width: 15ch; margin: var(--space-4) 0 0; color: var(--brand-maroon-deep); font: 780 clamp(1.55rem, 5vw, 2.2rem)/1 var(--font-display); }
	.contribution-card p { margin: var(--space-3) 0 0; color: var(--color-text-muted); line-height: 1.5; }
	.contribution-card > a { display: inline-flex; align-items: center; justify-content: center; width: fit-content; min-height: var(--tap-target); margin-top: auto; padding: 0 var(--space-4); border: 1px solid var(--brand-maroon-deep); border-radius: var(--radius-md); background: var(--brand-maroon-deep); color: var(--brand-cream); font-weight: 740; text-decoration: none; }
	.contribution-card > a:hover { background: var(--brand-maroon-ink); }
	.privacy-note { margin-top: var(--space-8); padding: var(--space-6); border-left: 0.35rem solid var(--brand-olive); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; background: var(--brand-sand); }
	.privacy-note h2 { margin: var(--space-2) 0 0; color: var(--brand-maroon-deep); font: 760 clamp(1.45rem, 5vw, 2rem)/1 var(--font-display); }
	.privacy-note > p:last-child { max-width: 48rem; margin: var(--space-3) 0 0; color: var(--color-text-muted); line-height: 1.55; }
	@media (min-width: 760px) {
		.contribute-hero { grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.42fr); align-items: end; }
		.contribution-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>
