---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Place Not Found — Kain Elbi"><main id="main-content" class="not-found page-shell"><p>404 · Route Changed</p><h1>That place is not in the current dataset.</h1><span>Open-data records can change between releases. Start a fresh route to see the candidates available now.</span><a href="/">Plan a New Break</a></main></Layout>
<style>
	.not-found { display: grid; align-content: center; min-height: 65dvh; padding-block: 3rem; }
	.not-found p { color: var(--text-accent); font: 750 .75rem/1 var(--font-display); letter-spacing: .12em; text-transform: uppercase; }
	.not-found h1 { max-width: 13ch; margin: .5rem 0 1rem; color: var(--forest); font: 790 clamp(2.7rem, 11vw, 5.8rem)/.9 var(--font-display); }
	.not-found span { max-width: 38rem; color: var(--muted); line-height: 1.5; }
	.not-found a { display: grid; place-items: center; width: fit-content; min-height: 3.25rem; margin-top: 1.5rem; padding: 0 1rem; border-radius: .9rem; color: white; background: var(--forest); font-weight: 750; text-decoration: none; }
</style>
