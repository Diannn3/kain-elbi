---
import Layout from '../../layouts/Layout.astro';
import PlaceHoursStatus from '../../components/place/PlaceHoursStatus.svelte';
import PlaceMiniMap from '../../components/map/PlaceMiniMap.svelte';
import ShareButton from '../../components/common/ShareButton.svelte';
import ListingFreshness from '../../components/place/ListingFreshness.svelte';
import VisitReportButton from '../../components/community/VisitReportButton.svelte';
import PhotoGallery from '../../components/place/PhotoGallery.svelte';
import VerifiedShopBadge from '../../components/place/VerifiedShopBadge.svelte';
import EditorPickBadge from '../../components/editorial/EditorPickBadge.svelte';
import OwnerEditorPickTools from '../../components/editorial/OwnerEditorPickTools.svelte';
import DishHighlights from '../../components/place/DishHighlights.svelte';
import QuickProblemReport from '../../components/place/QuickProblemReport.svelte';
import FoodJournalButton from '../../components/personal/FoodJournalButton.svelte';
import { formatAddedDate } from '../../lib/date-format';
import { loadBuildData } from '../../lib/data/build';
import { formatPriceRange } from '../../lib/data/place-enrichment';
import { categoryLabel, cuisineSummary, nearestAnchorContext, routeCoverageLabel } from '../../lib/place-presentation';
import type { Place } from '../../lib/types';

interface NearestContext {
	name: string;
	minutes: number;
	meters?: number;
}

export async function getStaticPaths() {
	const { places, matrix } = await loadBuildData();
	return places.map((place) => {
		const nearest = nearestAnchorContext(matrix, place.id);
		return {
			params: { id: place.id },
			props: {
				place,
				nearest: nearest ? {
					name: nearest.anchor.name,
					minutes: Math.max(1, Math.round(nearest.seconds / 60)),
					meters: nearest.meters,
				} : undefined,
				routeCoverage: routeCoverageLabel(matrix, place.id),
			},
		};
	});
}

interface Props {
	place: Place;
	nearest?: NearestContext;
	routeCoverage: string;
}

const { place, nearest, routeCoverage } = Astro.props;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${place.lat},${place.lon}&travelmode=walking`;
const cuisine = cuisineSummary(place);
const priceLabel = formatPriceRange(place.price);
const websiteUrl = place.website && /^https?:\/\//i.test(place.website) ? place.website : null;
const phoneUrl = place.phone ? `tel:${place.phone.replace(/[^+\d]/g, '')}` : null;
const sharePath = `/place/${encodeURIComponent(place.id)}`;
---

<Layout title={`${place.name} — UPPETITE`} description={`Location, hours, price information when available, and route coverage for ${place.name} near UPLB.`}>
	<main id="main-content" class="detail-page page-shell">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/">UPPETITE</a><span aria-hidden="true">/</span><span>Place</span><span aria-hidden="true">/</span><span>{place.name}</span>
		</nav>

		<section class="place-intro" aria-labelledby="place-title">
			<div class="intro-copy">
				<p class="eyebrow">{categoryLabel(place.category)}{cuisine ? ` · ${cuisine}` : ''}</p>
				<h1 id="place-title">{place.name}</h1>
				<VerifiedShopBadge place={place} />
				<EditorPickBadge client:idle placeId={place.id} />
				<PlaceHoursStatus client:load openingHours={place.openingHours} lat={place.lat} lon={place.lon} />
				<div class="primary-actions">
					<a class="directions" href={directionsUrl} target="_blank" rel="noreferrer">Get directions <span aria-hidden="true">↗</span></a>
					<a class="planner" href="/#route-planner">Plan around your class</a>
				</div>
				<div class="share-row">
					<FoodJournalButton client:load placeId={place.id} placeName={place.name} />
					<OwnerEditorPickTools client:idle placeId={place.id} placeName={place.name} />
					<ShareButton
						client:load
						label="Share place"
						title={`${place.name} — UPPETITE`}
						text={`Check out ${place.name} on UPPETITE.`}
						path={sharePath}
						variant="quiet"
					/>
				</div>
			</div>

			<div class="intro-note">
				<p class="note-label">UPPETITE route coverage</p>
				<strong>{routeCoverage}</strong>
				{nearest ? (
					<p>Nearest supported campus anchor: <b>{nearest.name}</b>, about {nearest.minutes} min away{nearest.meters ? ` (${Math.round(nearest.meters)} m)` : ''} on UPPETITE's current pedestrian graph.</p>
				) : (
					<p>You can still open this location in external maps, but UPPETITE will not invent a campus walking estimate where its graph does not reach.</p>
				)}
			</div>
		</section>

		<div class="content-grid">
			<section class="location-card" aria-labelledby="location-title">
				<div class="card-heading">
					<div><p class="section-label">Location</p><h2 id="location-title">See where it is.</h2></div>
					<a href={directionsUrl} target="_blank" rel="noreferrer">Open map ↗</a>
				</div>
				<PlaceMiniMap client:visible name={place.name} lat={place.lat} lon={place.lon} />
			</section>

			<section class="facts-card" aria-labelledby="details-title">
				<p class="section-label">Place details</p>
				<h2 id="details-title">What UPPETITE knows.</h2>
				<dl class="facts-list">
					<div><dt>Type</dt><dd>{categoryLabel(place.category)}</dd></div>
					<div><dt>Hours</dt><dd>{place.openingHours ? 'Source-listed hours available' : 'Hours unavailable'}</dd></div>
					{cuisine && <div><dt>Food tags</dt><dd>{cuisine}</dd></div>}
					{priceLabel && (
						<div>
							<dt>Online-listed meal</dt>
							<dd>{priceLabel}<small>Checked {formatAddedDate(place.price?.verifiedAt ?? '')}</small></dd>
						</div>
					)}
				{place.addedAt && <div><dt>Added</dt><dd>{formatAddedDate(place.addedAt)}</dd></div>}
					{websiteUrl && <div><dt>Website</dt><dd><a href={websiteUrl} target="_blank" rel="noreferrer">Visit website ↗</a></dd></div>}
					{phoneUrl && <div><dt>Phone</dt><dd><a href={phoneUrl}>{place.phone}</a></dd></div>}
				</dl>

				{place.openingHours && (
					<details class="schedule-detail">
						<summary>View source-listed schedule</summary>
						<code>{place.openingHours}</code>
					</details>
				)}

				<VisitReportButton client:idle placeId={place.id} placeName={place.name} />
				<ListingFreshness client:idle place={place} showBusinessAction />
				<QuickProblemReport client:idle placeId={place.id} placeName={place.name} />
				<DishHighlights place={place} />
				<PhotoGallery client:visible placeId={place.id} placeName={place.name} allowUpload={true} />
			</section>
		</div>

		<div class="bottom-actions">
			<a class="primary" href={directionsUrl} target="_blank" rel="noreferrer">Get directions <span aria-hidden="true">↗</span></a>
			<a href="/#route-planner">Find food for another break</a>
		</div>

		<p class="external-note">External directions open in Google Maps. UPPETITE does not store your exact GPS location on this page.</p>
	</main>
</Layout>

<style>
	.detail-page { padding-top: var(--space-4); padding-bottom: 5rem; }
	.breadcrumb { display: flex; gap: var(--space-2); min-width: 0; overflow: hidden; color: var(--color-text-muted); font-size: 0.75rem; white-space: nowrap; }
	.breadcrumb a { color: var(--brand-maroon-deep); font-weight: 700; text-underline-offset: 0.2em; }
	.breadcrumb span:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
	.place-intro { display: grid; gap: var(--space-4); margin-top: var(--space-6); }
	.intro-copy,
	.intro-note { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-xl); }
	.intro-copy { background: var(--brand-cream); box-shadow: 0 1rem 2.5rem rgb(71 12 17 / 0.07); }
	.intro-note { position: relative; align-content: end; background: var(--brand-sand); overflow: hidden; }
	.intro-note::before { content: ''; position: absolute; top: 1.2rem; right: 1.2rem; width: 0.85rem; height: 0.85rem; border: 3px solid var(--brand-orange); border-radius: 50%; background: var(--brand-cream); }
	.intro-note::after { content: ''; position: absolute; top: 2.15rem; right: 1.85rem; width: 4.25rem; border-top: 2px dashed var(--brand-orange); transform: rotate(-18deg); transform-origin: right center; }
	.eyebrow,
	.section-label,
	.note-label { margin: 0; color: var(--brand-maroon-deep); font: 760 0.72rem/1.25 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; }
	.intro-copy h1 { max-width: 17ch; margin: var(--space-2) 0 var(--space-4); color: var(--brand-maroon-deep); font: 790 clamp(2.7rem, 11vw, 5.5rem)/0.9 var(--font-display); letter-spacing: -0.025em; text-wrap: balance; }
	.primary-actions { display: grid; gap: var(--space-2); margin-top: var(--space-6); }
	.share-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
	.primary-actions a,
	.bottom-actions a { display: flex; align-items: center; justify-content: center; min-height: 3.5rem; padding: 0 var(--space-4); border-radius: var(--radius-md); font-weight: 750; text-align: center; text-decoration: none; }
	.directions,
	.bottom-actions .primary { border: 1px solid var(--brand-maroon-deep); background: var(--brand-maroon-deep); color: var(--brand-cream); }
	.directions:hover,
	.bottom-actions .primary:hover { background: var(--brand-maroon-ink); }
	.planner,
	.bottom-actions a:not(.primary) { border: 1px solid var(--brand-maroon-deep); background: transparent; color: var(--brand-maroon-deep); }
	.planner:hover,
	.bottom-actions a:not(.primary):hover { background: var(--brand-sand); }
	.intro-note .note-label { color: var(--brand-maroon-deep); }
	.intro-note strong { display: block; max-width: 16ch; margin-top: var(--space-2); color: var(--brand-maroon-deep); font: 760 clamp(1.4rem, 6vw, 2.2rem)/1 var(--font-display); }
	.intro-note p:last-child { max-width: 42ch; margin: var(--space-4) 0 0; color: var(--color-text-muted); line-height: 1.55; }
	.intro-note b { color: var(--brand-maroon-deep); }
	.content-grid { display: grid; gap: var(--space-4); margin-top: var(--space-4); }
	.location-card,
	.facts-card { padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
	.location-card { background: var(--brand-cream); }
	.facts-card { background: var(--brand-sand); }
	.card-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); }
	.card-heading h2,
	.facts-card h2 { max-width: 20ch; margin: var(--space-2) 0 0; color: var(--brand-maroon-deep); font: 770 clamp(1.55rem, 6vw, 2.35rem)/0.98 var(--font-display); }
	.card-heading > a { flex: none; min-height: var(--tap-target); display: flex; align-items: center; color: var(--brand-maroon-deep); font-weight: 720; text-underline-offset: 0.2em; }
	.facts-list { margin: var(--space-4) 0 0; }
	.facts-list > div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: var(--space-3); padding: var(--space-3) 0; border-top: 1px solid var(--color-border); }
	.facts-list dt { color: var(--color-text-muted); font-size: 0.78rem; }
	.facts-list dd { margin: 0; color: var(--color-text); font-weight: 650; line-height: 1.45; }
	.facts-list dd small { display: block; margin-top: 0.2rem; color: var(--color-text-muted); font-size: 0.72rem; font-weight: 500; }
	.facts-list a { color: var(--brand-maroon-deep); text-underline-offset: 0.2em; }
	.schedule-detail { margin-top: var(--space-2); border-top: 1px solid var(--color-border); }
	.schedule-detail summary { display: flex; align-items: center; min-height: var(--tap-target); cursor: pointer; color: var(--brand-maroon-deep); font-weight: 720; }
	.schedule-detail code { display: block; padding: var(--space-3); border-radius: var(--radius-sm); background: var(--brand-cream); color: var(--color-text-muted); font-size: 0.75rem; white-space: normal; overflow-wrap: anywhere; }
	.bottom-actions { display: grid; gap: var(--space-2); margin-top: var(--space-4); }
	.contribute-note,
	.external-note { max-width: 44rem; margin: var(--space-3) auto 0; color: var(--color-text-muted); font-size: 0.78rem; line-height: 1.45; text-align: center; }
	.contribute-note a { color: var(--brand-maroon-deep); font-weight: 720; text-underline-offset: 0.2em; }
	.external-note { margin-top: var(--space-2); font-size: 0.74rem; }

	@media (min-width: 760px) {
		.place-intro { grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr); }
		.intro-copy,
		.intro-note { padding: var(--space-8); }
		.primary-actions { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); max-width: 38rem; }
		.content-grid { grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr); }
		.location-card,
		.facts-card { padding: var(--space-6); }
		.bottom-actions { grid-template-columns: 1fr 1fr; }
	}
	@media (min-width: 1100px) { .intro-copy h1 { font-size: clamp(4.2rem, 7vw, 6rem); } }
</style>
