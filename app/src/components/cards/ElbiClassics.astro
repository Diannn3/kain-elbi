---
import type { Collection } from '../../lib/types';
interface Props { collections: Collection[] }
const { collections } = Astro.props;
const formatter = new Intl.DateTimeFormat('en-PH', { month: 'short', year: 'numeric' });
---

{collections.length > 0 && (
	<section class="classics page-shell" aria-labelledby="classics-heading">
		<div class="section-heading">
			<div>
				<p class="eyebrow-global">Elbi Classics</p>
				<h2 id="classics-heading">Student Landmarks & Local Finds</h2>
			</div>
		</div>
		<div class="collection-rail" tabindex="0" aria-label="Elbi Classics collections. Scroll horizontally for more.">
			{collections.map((collection, index) => (
				<article class={`collection collection--${collection.coverVariant}`}>
					<div class="cover" aria-hidden="true">
						<span class="orbit"></span>
						<span class="route"></span>
						<span class="plate">{index + 1}</span>
						<svg viewBox="0 0 120 120"><path d="M20 76c25-7 34-38 57-40 11-1 20 5 24 16M16 93c19-9 37-4 55 2 13 4 24 3 34-3" /><circle cx="23" cy="75" r="5" /><circle cx="100" cy="52" r="5" /></svg>
					</div>
					<div class="collection-copy">
						<p>Research-Backed Collection</p>
						<h3>{collection.title}</h3>
						<span>{collection.description}</span>
						<small>
							{`${collection.evidenceCount} sources reviewed · ${formatter.format(new Date(collection.researchDate))}`}
						</small>
					</div>
				</article>
			))}
		</div>
	</section>
)}

<style>
	.classics { margin-top: clamp(4rem, 10vw, 8rem); }
	.section-heading h2 { max-width: 16ch; }
	.collection-rail { display: grid; grid-auto-flow: column; grid-auto-columns: min(82vw, 24rem); gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.25rem 1rem 1.5rem 0; scrollbar-color: var(--leaf) transparent; }
	.collection { position: relative; min-height: 25rem; overflow: hidden; border-radius: 1.75rem; color: white; background: var(--forest); scroll-snap-align: start; box-shadow: 0 1.2rem 2.5rem hsl(154 40% 8% / 0.14); transition: transform 180ms ease, box-shadow 180ms ease; }
	.collection:hover { transform: translateY(-4px); box-shadow: 0 1.6rem 3rem hsl(154 40% 8% / 0.2); }
	.cover { position: absolute; inset: 0; overflow: hidden; }
	.collection--sun .cover { background: var(--sun); color: var(--forest); }
	.collection--leaf .cover { background: var(--leaf); color: white; }
	.collection--forest .cover { background: var(--forest-deep); color: var(--sun); }
	.cover::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, hsl(154 78% 7% / 0.92)); }
	.orbit { position: absolute; width: 17rem; aspect-ratio: 1; top: -5rem; right: -5rem; border: 1px solid currentColor; border-radius: 50%; opacity: 0.3; box-shadow: 0 0 0 2rem hsl(0 0% 100% / 0.06), 0 0 0 4rem hsl(0 0% 100% / 0.04); }
	.cover svg { position: absolute; top: 2rem; left: 1rem; width: 95%; fill: none; stroke: currentColor; stroke-width: 2; stroke-dasharray: 5 5; opacity: 0.8; }
	.plate { position: absolute; top: 4.8rem; left: 50%; display: grid; place-items: center; width: 6.5rem; aspect-ratio: 1; border: 1px solid currentColor; border-radius: 50%; color: currentColor; font: 800 3rem/1 var(--font-display); transform: translateX(-50%) rotate(-7deg); }
	.collection-copy { position: absolute; z-index: 2; inset: auto 1rem 1rem; padding: 1rem; border: 1px solid hsl(0 0% 100% / .12); border-radius: 1rem; background: hsl(154 78% 7% / .92); backdrop-filter: blur(8px); }
	.collection-copy p { margin: 0 0 0.5rem; color: var(--sun); font: 760 0.7rem/1 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; }
	.collection-copy h3 { margin: 0; font: 780 2rem/0.95 var(--font-display); }
	.collection-copy > span { display: -webkit-box; margin-top: 0.7rem; overflow: hidden; color: hsl(0 0% 100% / 0.82); line-height: 1.4; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
	.collection-copy small { display: block; margin-top: 0.9rem; color: hsl(0 0% 100% / 0.76); }
	@media (min-width: 760px) { .collection-rail { grid-auto-columns: min(34vw, 24rem); } }
	@media (prefers-reduced-motion: reduce) { .collection { transition: none; } }
</style>
