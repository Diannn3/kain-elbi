---
interface Props {
	home?: boolean;
}

const { home = false } = Astro.props;
---

<button
	type="button"
	class:list={['developer-trigger', { 'developer-trigger--home': home }]}
	data-developer-contact-trigger
	aria-haspopup="dialog"
	aria-controls="developer-contact-dialog"
	aria-label="Developer contact"
>
	<svg aria-hidden="true" viewBox="0 0 24 24">
		<circle cx="12" cy="8" r="3.25" />
		<path d="M5.5 20c.45-4 2.8-6 6.5-6s6.05 2 6.5 6" />
	</svg>
	<span>Developer</span>
</button>

<style>
	.developer-trigger {
		min-width: var(--tap-target);
		min-height: var(--tap-target);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		gap: var(--space-2);
		padding: 0 var(--space-4);
		border: 1px solid rgb(92 16 22 / 0.3);
		border-radius: 0.9rem;
		background: transparent;
		color: var(--brand-maroon-deep);
		font: 730 0.84rem/1 var(--font-display);
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			color 150ms ease;
	}

	.developer-trigger:hover {
		border-color: var(--brand-maroon-deep);
		background: var(--brand-sand);
	}

	.developer-trigger svg {
		width: 1.12rem;
		height: 1.12rem;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.developer-trigger--home {
		border-color: rgb(255 249 241 / 0.68);
		color: var(--brand-cream);
	}

	.developer-trigger--home:hover {
		border-color: var(--brand-cream);
		background: rgb(255 249 241 / 0.12);
		color: var(--brand-cream);
	}

	@media (max-width: 759px) {
		.developer-trigger {
			width: var(--tap-target);
			padding: 0;
			border-radius: 0.85rem;
		}

		.developer-trigger span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.developer-trigger svg {
			width: 1.2rem;
			height: 1.2rem;
		}
	}
</style>
