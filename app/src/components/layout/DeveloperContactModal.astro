---
import { developer } from '../../lib/developer';

const contacts = [
	{ key: 'facebook', ...developer.contacts.facebook },
	{ key: 'portfolio', ...developer.contacts.portfolio },
	{ key: 'linkedin', ...developer.contacts.linkedin },
	{ key: 'email', ...developer.contacts.email },
] as const;
---

<dialog
	id="developer-contact-dialog"
	class="developer-contact-dialog"
	aria-labelledby="developer-contact-title"
	aria-describedby="developer-contact-description"
	data-developer-contact-dialog
>
	<div class="dialog-accent" aria-hidden="true"></div>

	<button
		type="button"
		class="dialog-close"
		aria-label="Close developer contact"
		data-developer-contact-close
	>
		<svg aria-hidden="true" viewBox="0 0 24 24">
			<path d="m7 7 10 10M17 7 7 17" />
		</svg>
	</button>

	<header class="dialog-heading">
		<p class="dialog-eyebrow">UPPETITE</p>
		<h2 id="developer-contact-title">Developer Contact</h2>
		<p id="developer-contact-description">Connect with the developer behind UPPETITE.</p>
	</header>

	<section class="developer-profile" aria-label="Developer">
		<div class="profile-photo-placeholder" aria-hidden="true"></div>
		<div>
			<h3>{developer.name}</h3>
			<p>{developer.role}</p>
		</div>
	</section>

	<div class="contact-list" aria-label="Developer contact links">
		{contacts.map((contact) => (
			contact.href ? (
				<a
					class:list={['contact-row', `contact-row--${contact.key}`]}
					href={contact.href}
					target={contact.key === 'email' ? undefined : '_blank'}
					rel={contact.key === 'email' ? undefined : 'noopener noreferrer'}
				>
					<span class="contact-icon" aria-hidden="true">
						{contact.key === 'facebook' && <span class="facebook-glyph">f</span>}
						{contact.key === 'linkedin' && <span class="linkedin-glyph">in</span>}
						{contact.key === 'email' && (
							<svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v11h-17v-11Zm1 1 7.5 6 7.5-6" /></svg>
						)}
					</span>
					<span class="contact-text">
						<span class="contact-label">{contact.label}</span>
						<span class="contact-value">{contact.display}</span>
					</span>
					<span class="contact-arrow" aria-hidden="true">↗</span>
					{contact.key !== 'email' && <span class="sr-only"> (opens in a new tab)</span>}
				</a>
			) : (
				<div class:list={['contact-row', 'contact-row--disabled', `contact-row--${contact.key}`]}>
					<span class="contact-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<path d="M14 5h5v5M19 5l-8 8M17 13v5H6V7h5" />
						</svg>
					</span>
					<span class="contact-text">
						<span class="contact-label">{contact.label}</span>
						<span class="contact-value">{contact.display}</span>
					</span>
				</div>
			)
		))}
	</div>

	<p class="contact-note">
		For place corrections, missing food spots, business updates, or events, use
		<a href="/contribute">Contribute to UPPETITE</a>.
	</p>
</dialog>

<script is:inline>
	(() => {
		const dialog = document.querySelector('[data-developer-contact-dialog]');
		if (!(dialog instanceof HTMLDialogElement)) return;

		const closeButton = dialog.querySelector('[data-developer-contact-close]');
		let lastTrigger = null;

		function openDeveloperContact(event) {
			const trigger = event.currentTarget;
			if (!(trigger instanceof HTMLElement)) return;

			event.preventDefault();
			lastTrigger = trigger;

			if (typeof dialog.showModal === 'function') {
				dialog.showModal();
			} else {
				dialog.setAttribute('open', '');
			}

			if (closeButton instanceof HTMLElement) {
				requestAnimationFrame(() => closeButton.focus());
			}
		}

		for (const trigger of document.querySelectorAll('[data-developer-contact-trigger]')) {
			trigger.addEventListener('click', openDeveloperContact);
		}

		if (closeButton instanceof HTMLElement) {
			closeButton.addEventListener('click', () => dialog.close());
		}

		dialog.addEventListener('click', (event) => {
			const rect = dialog.getBoundingClientRect();
			const outside =
				event.clientX < rect.left ||
				event.clientX > rect.right ||
				event.clientY < rect.top ||
				event.clientY > rect.bottom;

			if (outside) dialog.close();
		});

		dialog.addEventListener('close', () => {
			if (lastTrigger instanceof HTMLElement) {
				requestAnimationFrame(() => lastTrigger.focus());
			}
		});
	})();
</script>

<style>
	.developer-contact-dialog {
		position: fixed;
		width: min(33rem, calc(100% - 2rem));
		max-height: min(44rem, calc(100svh - 2rem));
		margin: auto;
		padding: 0;
		overflow-x: hidden;
		overflow-y: auto;
		border: 1px solid var(--color-border-strong);
		border-radius: 1.1rem;
		background: var(--brand-cream);
		color: var(--brand-charcoal);
		box-shadow: 0 1.75rem 5rem rgb(35 4 8 / 0.34);
	}

	.developer-contact-dialog::backdrop {
		background: rgb(27 5 8 / 0.72);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.dialog-accent {
		position: sticky;
		z-index: 2;
		top: 0;
		height: 0.38rem;
		background: linear-gradient(
			90deg,
			var(--brand-maroon-deep) 0%,
			var(--brand-orange) 48%,
			var(--brand-olive) 100%
		);
	}

	.dialog-close {
		position: absolute;
		z-index: 3;
		top: 1rem;
		right: 1rem;
		width: var(--tap-target);
		height: var(--tap-target);
		display: grid;
		place-items: center;
		padding: 0;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.75rem;
		background: transparent;
		color: var(--brand-maroon-deep);
	}

	.dialog-close:hover {
		background: var(--brand-sand);
	}

	.dialog-close svg {
		width: 1.45rem;
		height: 1.45rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.dialog-heading {
		padding: 2.1rem 4.75rem 1.7rem 2rem;
	}

	.dialog-eyebrow {
		margin: 0 0 0.5rem;
		color: var(--brand-orange);
		font: 760 0.67rem/1 var(--font-display);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.dialog-heading h2 {
		margin: 0;
		color: var(--brand-maroon-deep);
		font: 780 clamp(1.5rem, 5vw, 1.9rem)/1 var(--font-display);
		letter-spacing: -0.035em;
	}

	.dialog-heading > p:last-child {
		margin: 0.65rem 0 0;
		color: var(--color-text-muted);
		line-height: 1.5;
	}

	.developer-profile {
		display: grid;
		grid-template-columns: 4.25rem minmax(0, 1fr);
		align-items: center;
		gap: 1.1rem;
		margin: 0 2rem;
		padding: 0 0 1.7rem;
		border-bottom: 1px solid var(--color-border);
	}

	.profile-photo-placeholder {
		width: 4.25rem;
		height: 4.25rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 50%;
		background:
			radial-gradient(circle at 50% 37%, rgb(92 16 22 / 0.08) 0 22%, transparent 23%),
			radial-gradient(circle at 50% 90%, rgb(92 16 22 / 0.07) 0 36%, transparent 37%),
			var(--brand-sand);
	}

	.developer-profile h3 {
		margin: 0;
		color: var(--brand-charcoal);
		font: 770 1.08rem/1.2 var(--font-display);
	}

	.developer-profile p {
		margin: 0.35rem 0 0;
		color: var(--color-text-muted);
		line-height: 1.4;
	}

	.contact-list {
		display: grid;
		padding: 1rem 1rem 0.5rem;
	}

	.contact-row {
		min-width: 0;
		min-height: 4rem;
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.8rem;
		padding: 0.65rem 1rem;
		border-radius: 0.85rem;
		color: var(--brand-charcoal);
		text-decoration: none;
	}

	a.contact-row:hover,
	a.contact-row:focus-visible {
		background: var(--brand-sand);
	}

	.contact-row--disabled {
		color: var(--color-text-muted);
	}

	.contact-icon {
		width: 2.15rem;
		height: 2.15rem;
		display: grid;
		place-items: center;
		border-radius: 0.65rem;
		background: rgb(92 16 22 / 0.06);
		color: var(--brand-maroon-deep);
		font-weight: 800;
	}

	.contact-row--facebook .contact-icon {
		color: #1877f2;
	}

	.contact-row--linkedin .contact-icon {
		color: #0a66c2;
	}

	.contact-row--email .contact-icon {
		color: var(--brand-orange);
	}

	.contact-icon svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.facebook-glyph {
		font: 820 1.35rem/1 Arial, sans-serif;
	}

	.linkedin-glyph {
		font: 820 0.9rem/1 Arial, sans-serif;
	}

	.contact-text {
		min-width: 0;
		display: grid;
		gap: 0.2rem;
	}

	.contact-label {
		color: var(--color-text-muted);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.contact-value {
		min-width: 0;
		overflow-wrap: anywhere;
		color: inherit;
		font-weight: 650;
		line-height: 1.35;
	}

	.contact-arrow {
		color: var(--brand-maroon-deep);
		font-size: 1.1rem;
	}

	.contact-note {
		margin: 0 2rem 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: 0.78rem;
		line-height: 1.55;
	}

	.contact-note a {
		min-height: var(--tap-target);
		display: inline-flex;
		align-items: center;
		color: var(--brand-maroon-deep);
		font-weight: 700;
		text-underline-offset: 0.2em;
	}

	@media (max-width: 430px) {
		.developer-contact-dialog {
			width: calc(100% - 1.25rem);
			max-height: calc(100svh - 1.25rem);
			border-radius: 1rem;
		}

		.dialog-heading {
			padding: 1.85rem 4.25rem 1.45rem 1.35rem;
		}

		.developer-profile {
			margin-inline: 1.35rem;
			grid-template-columns: 3.75rem minmax(0, 1fr);
		}

		.profile-photo-placeholder {
			width: 3.75rem;
			height: 3.75rem;
		}

		.contact-list {
			padding-inline: 0.35rem;
		}

		.contact-row {
			padding-inline: 0.85rem;
		}

		.contact-note {
			margin-inline: 1.35rem;
		}
	}
</style>
