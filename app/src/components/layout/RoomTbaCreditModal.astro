<dialog
	id="room-tba-credit-dialog"
	class="room-tba-credit-dialog"
	aria-labelledby="room-tba-credit-title"
	aria-describedby="room-tba-credit-description"
	data-room-tba-credit-dialog
>
	<button
		type="button"
		class="dialog-close"
		aria-label="Close Room TBA credit"
		data-room-tba-credit-close
	>
		<span aria-hidden="true">×</span>
	</button>

	<header class="credit-heading">
		<p class="credit-eyebrow">Routing attribution</p>
		<h2 id="room-tba-credit-title">Room TBA</h2>
		<p id="room-tba-credit-description">
			UPPETITE's pedestrian-routing pipeline uses a generated walking graph sourced from
			Room TBA, an open-source UPLB campus mapping project.
		</p>
	</header>

	<section class="copyright-block" aria-label="Room TBA copyright">
		<p class="project-name">Room TBA</p>
		<p>© 2026 Simonee Ezekiel Mariquit</p>
		<p>MIT License</p>
	</section>

	<section class="provenance" aria-labelledby="room-tba-provenance-title">
		<h3 id="room-tba-provenance-title">Upstream provenance</h3>
		<dl>
			<div>
				<dt>Source file</dt>
				<dd><code>src/generated/walk-graph.json</code></dd>
			</div>
			<div>
				<dt>Pinned revision</dt>
				<dd><code>feb008212af6b54d3344f44c4a33672b50983fcc</code></dd>
			</div>
		</dl>
	</section>

	<p class="osm-note">
		The imported graph records its path network as derived from OpenStreetMap data:
		<strong>© OpenStreetMap contributors</strong>, ODbL.
	</p>

	<nav class="credit-actions" aria-label="Room TBA attribution links">
		<a href="https://github.com/uplbtools/room-tba" target="_blank" rel="noopener noreferrer">
			View Room TBA ↗<span class="sr-only"> (opens in a new tab)</span>
		</a>
		<a href="https://github.com/uplbtools/room-tba/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">
			View MIT license ↗<span class="sr-only"> (opens in a new tab)</span>
		</a>
	</nav>

	<p class="scope-note">
		This attribution applies to the Room TBA material UPPETITE uses. It does not license
		UPPETITE's original source code or branding.
	</p>
</dialog>

<script is:inline>
	(() => {
		const dialog = document.querySelector('[data-room-tba-credit-dialog]');
		if (!(dialog instanceof HTMLDialogElement)) return;

		const closeButton = dialog.querySelector('[data-room-tba-credit-close]');
		let lastTrigger = null;

		function openCredit(event) {
			const trigger = event.currentTarget;
			if (!(trigger instanceof HTMLElement)) return;

			lastTrigger = trigger;
			if (!dialog.open) dialog.showModal();
			if (closeButton instanceof HTMLElement) {
				requestAnimationFrame(() => closeButton.focus());
			}
		}

		for (const trigger of document.querySelectorAll('[data-room-tba-credit-trigger]')) {
			trigger.addEventListener('click', openCredit);
		}

		if (closeButton instanceof HTMLElement) {
			closeButton.addEventListener('click', () => dialog.close());
		}

		dialog.addEventListener('click', (event) => {
			const rect = dialog.getBoundingClientRect();
			const outside =
				event.clientX < rect.left ||
				event.clientX > rect.right ||
				event.clientY < rect.top ||
				event.clientY > rect.bottom;

			if (outside) dialog.close();
		});

		dialog.addEventListener('close', () => {
			if (lastTrigger instanceof HTMLElement) {
				requestAnimationFrame(() => lastTrigger.focus());
			}
		});
	})();
</script>

