---

<header class="site-header">
	<div class="header-inner">
		<a class="wordmark" href="/" translate="no">Kain Elbi<span aria-hidden="true">.</span></a>
		<nav aria-label="Primary navigation">
			<a href="/">Discover</a>
			<a href="/map">Map</a>
		</nav>
	</div>
</header>

<style>
	.site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--line); }
	.header-inner { width: var(--page); min-height: 4.5rem; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.wordmark { color: var(--forest); font: 820 1.3rem/1 var(--font-display); letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
	.wordmark span { color: var(--sun); }
	nav { display: flex; align-items: center; gap: 1rem; }
	nav a { min-height: 2.75rem; display: grid; place-items: center; color: var(--forest); font-weight: 720; text-decoration: none; }
	nav a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
	@media (max-width: 759px) { nav a:first-child { display: none; } }
</style>
