---
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const isHome = currentPath === '/';
const isMap = currentPath.startsWith('/map');
---

<header class="site-header">
	<div class="header-inner">
		<a class="wordmark" href="/" translate="no">Kain Elbi<span aria-hidden="true">.</span></a>
		<nav aria-label="Primary navigation">
			<a href="/" aria-current={isHome ? 'page' : undefined}>Discover</a>
			<a href="/map" aria-current={isMap ? 'page' : undefined}>Map</a>
		</nav>
	</div>
</header>

<style>
	.site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--border-subtle); }
	.header-inner { width: var(--page); min-height: 4.5rem; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.wordmark { min-height: var(--tap-target); display: flex; align-items: center; color: var(--forest); font: 820 1.3rem/1 var(--font-display); letter-spacing: 0.07em; text-decoration: none; text-transform: uppercase; }
	.wordmark span { color: var(--sun); }
	nav { display: flex; align-items: center; gap: 0.5rem; }
	nav a { min-height: var(--tap-target); display: grid; place-items: center; padding: 0 0.65rem; border-radius: 0.75rem; color: var(--forest); font-weight: 720; text-decoration: none; }
	nav a:hover { background: var(--surface-subtle); }
	nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 0.12em; text-underline-offset: 0.35em; }
	@media (max-width: 759px) { nav a:first-child { display: none; } }
</style>
