---
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const isFind = currentPath === '/' || currentPath.startsWith('/picks');
const isExplore = currentPath.startsWith('/explore');
const isFreshie = currentPath.startsWith('/freshie');
---
<header class="site-header">
	<div class="header-inner">
		<a class="wordmark" href="/" translate="no">Kain Elbi<span aria-hidden="true">.</span></a>
		<nav aria-label="Primary navigation">
			<a href="/" aria-current={isFind ? 'page' : undefined}>Find</a>
			<a href="/explore" aria-current={isExplore ? 'page' : undefined}>Explore</a>
			<a href="/freshie" aria-current={isFreshie ? 'page' : undefined}>Freshie</a>
		</nav>
	</div>
</header>
<style>
	.site-header{position:relative;z-index:20;border-bottom:1px solid var(--border-subtle)}.header-inner{width:var(--page);min-height:4.5rem;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:1rem}.wordmark{min-height:var(--tap-target);display:flex;align-items:center;color:var(--forest);font:820 1.3rem/1 var(--font-display);letter-spacing:.07em;text-decoration:none;text-transform:uppercase}.wordmark span{color:var(--sun)}nav{display:flex;align-items:center;gap:.25rem}nav a{min-height:var(--tap-target);display:grid;place-items:center;padding:0 .7rem;border-radius:.75rem;color:var(--forest);font-weight:720;text-decoration:none}nav a:hover{background:var(--surface-subtle)}nav a[aria-current='page']{background:var(--forest);color:white}@media(max-width:759px){nav{display:none}}
</style>
