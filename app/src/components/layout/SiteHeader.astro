---
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const isFind = currentPath === '/' || currentPath.startsWith('/picks');
const isExplore = currentPath.startsWith('/explore');
const isFreshie = currentPath.startsWith('/freshie');
const isHome = currentPath === '/';
---

<header class:list={['site-header', { 'site-header--home': isHome }]}>
	<div class="header-inner">
		<a class="brand" href="/" aria-label="UPPETITE home" translate="no">
			<img src="/brand/uppetite-mark-header.png" alt="" width="96" height="96" loading="eager" decoding="async" fetchpriority="high" />
			<span>UPPETITE</span>
		</a>
		<nav aria-label="Primary navigation">
			<a href="/" aria-current={isFind ? 'page' : undefined}>Find</a>
			<a href="/explore" aria-current={isExplore ? 'page' : undefined}>Explore</a>
			<a href="/freshie" aria-current={isFreshie ? 'page' : undefined}>Freshie</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 40;
		border-bottom: 1px solid var(--color-border);
		background: rgb(255 249 241 / 0.92);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
	}

	.header-inner {
		width: var(--page);
		min-height: 4.5rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		min-width: 0;
		min-height: var(--tap-target);
		display: flex;
		align-items: center;
		gap: var(--space-1);
		text-decoration: none;
		color: var(--brand-maroon-deep);
		font: 820 1.2rem/1 var(--font-display);
		letter-spacing: 0.055em;
	}

	.brand img {
		width: auto;
		height: 2.25rem;
		max-width: 2.25rem;
		object-fit: contain;
		object-position: left center;
		transform: translateY(var(--space-1)) scale(1.65);
		transform-origin: center;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	nav a {
		min-height: var(--tap-target);
		display: grid;
		place-items: center;
		padding: 0 0.8rem;
		border-radius: 0.8rem;
		color: var(--color-primary);
		font-weight: 720;
		font-size: 0.9rem;
		text-decoration: none;
		transition: background-color 150ms ease, color 150ms ease;
	}

	nav a:hover {
		background: var(--color-surface-muted);
	}

	nav a[aria-current='page'] {
		background: var(--color-primary);
		color: var(--color-on-primary);
	}

	.site-header--home {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		border-bottom-color: rgb(255 249 241 / 0.16);
		background: linear-gradient(to bottom, rgb(35 4 8 / 0.34), rgb(35 4 8 / 0));
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.site-header--home nav a {
		color: var(--brand-cream);
	}

	.site-header--home .brand { color: var(--brand-cream); }

	.site-header--home nav a:hover {
		background: rgb(255 249 241 / 0.11);
	}

	.site-header--home nav a[aria-current='page'] {
		background: var(--brand-cream);
		color: var(--brand-maroon-deep);
	}

	@media (max-width: 759px) {
		.header-inner {
			min-height: 4.25rem;
		}

		.brand img {
			height: 1.95rem;
		}

		nav {
			display: none;
		}
	}
</style>
